<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ФОН -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_easter"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== ВЕРХНИЙ БЛОК: ТАЙМЕР + СЧЁТ ===== -->

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_left_20"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="22sp"
        android:padding="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/eggs_collected_0"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="20sp"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/timerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Бонусные (редкие) яйца в процессе игры -->
    <TextView
        android:id="@+id/bonusEggText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bonus_eggs_0"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="18sp"
        android:padding="2dp"
        app:layout_constraintTop_toBottomOf="@id/countText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_collect_eggs"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/bonusEggText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ЯЙЦО (во время игры) -->

    <ImageButton
        android:id="@+id/tapButton"
        android:layout_width="110dp"
        android:layout_height="140dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/egg_button"
        android:contentDescription="@string/tap_button"
        app:layout_constraintTop_toBottomOf="@id/textViewInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tapToStartText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_to_start"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="18sp"
        android:padding="6dp"
        android:shadowColor="#AA000000"
        android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/tapButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>


    <!-- ===== ИТОГОВЫЙ БЛОК-КАРТОЧКА (ПОСЛЕ ИГРЫ) ===== -->

    <LinearLayout
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/result_card_bg"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tapButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Верхняя строка: корзина + Total / Rare -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imgBasket"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/easter_basket"
                android:contentDescription="@string/basket_content_desc"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Total eggs + иконка обычного яйца -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/egg_button"
                        android:contentDescription="@string/total_eggs_desc"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/totalEggsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_eggs_this_game"
                        android:textColor="@color/orange"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Rare eggs + иконка золотого яйца -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/egg_golden"
                        android:contentDescription="@string/rare_eggs_desc"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/rareEggsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rare_eggs_this_game"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Top 5 -->
        <TextView
            android:id="@+id/topScoresTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/top_5_scores"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/topScoresText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:paddingTop="2dp" />

        <!-- Поддерживающие фразы под результатами -->
        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bunny_greeting"
            android:textColor="@color/sandy_brown"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtAnother"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bunny_another"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/txtOneMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bunny_one_more"
            android:textColor="@color/blue"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- ===== КНОПКИ ВНИЗУ ===== -->

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/reset"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/resetHighScoresButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/reset_high_scores"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white" />

    </LinearLayout>

    <!-- Кнопки смены текста (если понадобятся позже) -->

    <LinearLayout
        android:id="@+id/themeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChange"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/change"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/blue"
            android:visibility="gone"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnChangeBack"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/change_back"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/blue"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
