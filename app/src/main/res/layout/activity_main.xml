<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- ФОН КАРТИНКОЙ -->
    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_easter"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== ВЕРХНИЙ БЛОК: ТАЙМЕР + СЧЁТ + ПОДСКАЗКА ===== -->

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/time_left_20"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="22sp"
        android:padding="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/countText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/eggs_collected_0"
        android:textColor="@color/yellow"
        android:textStyle="bold"
        android:textSize="20sp"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/timerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_collect_eggs"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/countText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- КНОПКА ЯЙЦА -->

    <ImageButton
        android:id="@+id/tapButton"
        android:layout_width="110dp"
        android:layout_height="140dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/egg_button"
        android:contentDescription="@string/tap_button"
        app:layout_constraintTop_toBottomOf="@id/textViewInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TOP 5 HUNTERS ПОД ЯЙЦОМ -->

    <TextView
        android:id="@+id/topScoresText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/top_5_scores"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="14sp"
        android:padding="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tapButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 🔥 ЗАЙЧИК + КОРЗИНА СЛЕВА, НАД НИЖНИМИ КНОПКАМИ -->

    <!-- Корзинка ближе к низу, слева -->
    <ImageView
        android:id="@+id/imgBasket"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:visibility="gone"
        app:srcCompat="@drawable/easter_basket"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="16dp" />

    <!-- Зайчик над корзинкой, чуть больше -->
    <ImageView
        android:id="@+id/imgBunny"
        android:layout_width="130dp"
        android:layout_height="180dp"
        android:visibility="gone"
        app:srcCompat="@drawable/easter_bunny"
        android:contentDescription="@string/app_name"
        app:layout_constraintBottom_toTopOf="@id/imgBasket"
        app:layout_constraintStart_toStartOf="@id/imgBasket"
        android:layout_marginBottom="-28dp" />

    <!-- ТЕКСТЫ ПОД КОРЗИНОЙ -->

    <TextView
        android:id="@+id/txtGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bunny_greeting"
        android:textColor="@color/sandy_brown"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/imgBasket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtAnother"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bunny_another"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtGreeting"
        app:layout_constraintStart_toStartOf="@id/txtGreeting" />

    <TextView
        android:id="@+id/txtOneMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bunny_one_more"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtAnother"
        app:layout_constraintStart_toStartOf="@id/txtAnother" />

    <!-- ===================== КНОПКИ ВНИЗУ ===================== -->

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/resetButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/reset"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/resetHighScoresButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/reset_high_scores"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- ВТОРАЯ ЛИНИЯ КНОПОК: ТЕМЫ -->

    <LinearLayout
        android:id="@+id/themeButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/bottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnChange"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/change"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/blue"
            android:visibility="gone"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnChangeBack"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/change_back"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="@color/blue"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
